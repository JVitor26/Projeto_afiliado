# Banco local
DATABASE_PATH=data/affiliate.db
PUBLIC_BASE_URL=

# Nichos buscados diariamente. Ajuste para seu publico.
KEYWORDS=celular,smartphone,iphone,notebook,monitor,ssd,fone bluetooth,headset gamer,smartwatch,tablet,caixa de som bluetooth,teclado gamer,mouse gamer,roteador wifi,webcam,carregador turbo,power bank,air fryer,fritadeira eletrica,panela eletrica,liquidificador,cafeteira,aspirador de po,ventilador,climatizador,geladeira,micro-ondas,maquina de lavar,lava e seca,purificador de agua,organizador,utensilios de cozinha,jogo de panelas,panelas,cama mesa banho,toalha,jogo de cama,luminaria,suporte de parede,furadeira,parafusadeira,ferramentas,jogo de ferramentas,caixa de ferramentas,serra eletrica,esmerilhadeira,lavadora de alta pressao,compressor de ar,kit automotivo,acessorios carro,carregador veicular,camera veicular,aspirador automotivo,pneu,calibrador pneu,suporte celular carro,som automotivo
DENY_KEYWORDS=usado,quebrado,defeito,recondicionado
ENABLED_SOURCES=manual,mercadolivre,shopee,amazon,aliexpress
MIN_PRICE=0
MAX_PRICE=0
MIN_DISCOUNT_PERCENT=0
MIN_SCORE_TO_PUBLISH=25
REQUIRE_PRODUCT_IMAGE=true
MIN_SOLD_QUANTITY=5
MIN_SELLER_TRANSACTIONS=25

# Produtos preenchidos manualmente enquanto as APIs nao estao liberadas.
MANUAL_PRODUCTS_PATH=data/manual_products.csv
MANUAL_AFFILIATE_ID=
MANUAL_AFFILIATE_TEMPLATE={url}

# Mercado Livre
MERCADOLIVRE_SITE_ID=MLB
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=
MERCADOLIVRE_ACCESS_TOKEN=
MERCADOLIVRE_REFRESH_TOKEN=
MERCADOLIVRE_AFFILIATE_ID=
MERCADOLIVRE_AFFILIATE_TEMPLATE={url}

# Shopee: use arquivo/export oficial ou endpoint proprio/API oficial que retorne JSON.
# Para ShopeeOfferV2, o sistema envia keyword, sortType, page e limit.
# sortType: 1 = novidades/recentes; 2 = maior comissao.
SHOPEE_FEED_PATH=data/shopee_products.example.json
SHOPEE_PRODUCT_FEED_URL=
SHOPEE_AUTHORIZATION_HEADER=
SHOPEE_AFFILIATE_ID=
SHOPEE_AFFILIATE_TEMPLATE={url}
SHOPEE_SORT_TYPE=1
SHOPEE_START_PAGE=1

# Amazon: priorize Creators API, feed/export oficial ou endpoint proprio.
# PA-API foi mantida como modo legado para contas que ainda tiverem acesso.
AMAZON_MODE=auto
AMAZON_FEED_PATH=
AMAZON_PRODUCT_FEED_URL=
AMAZON_AUTHORIZATION_HEADER=
AMAZON_CREATORS_API_URL=
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_VERSION=3.1
AMAZON_CREATORS_TOKEN_URL=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_PARTNER_TYPE=Associates
AMAZON_HOST=webservices.amazon.com.br
AMAZON_REGION=us-east-1
AMAZON_MARKETPLACE=www.amazon.com.br
AMAZON_SEARCH_INDEX=All
AMAZON_AFFILIATE_TEMPLATE={url}

# AliExpress: use API oficial de afiliados, feed/export oficial ou endpoint proprio.
ALIEXPRESS_MODE=auto
ALIEXPRESS_FEED_PATH=
ALIEXPRESS_PRODUCT_FEED_URL=
ALIEXPRESS_AUTHORIZATION_HEADER=
ALIEXPRESS_API_URL=https://api-sg.aliexpress.com/sync
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_AFFILIATE_TEMPLATE={url}
ALIEXPRESS_SIGN_METHOD=sha256
ALIEXPRESS_TARGET_CURRENCY=BRL
ALIEXPRESS_TARGET_LANGUAGE=PT
ALIEXPRESS_SHIP_TO_COUNTRY=BR
ALIEXPRESS_SORT=
ALIEXPRESS_START_PAGE=1
ALIEXPRESS_FIELDS=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=false

# Outras redes via n8n, Make, Zapier, Meta Graph proxy, etc.
SOCIAL_WEBHOOK_URLS=
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb6G99PK0IBmcPVy8s2w
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CHAT_IDS=

# Automacao
MINE_LIMIT_PER_KEYWORD=20
PUBLISH_LIMIT=1
INTERVAL_MINUTES=8
